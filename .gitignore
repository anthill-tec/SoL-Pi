# Machine-local overlay (values that stay on this machine) — never committed.
.env.local

# CR worktrees live inside the repo (inheriting Pi's project trust).
.worktrees/

# Tooling debris.
__pycache__/
test-reports/
# coverage.py data (a parallel run's per-process parts too) and its lcov, when a run reports
# at the project root rather than into test-reports/<agent>/.
.coverage
.coverage.*
coverage.lcov

# Project registry (holds the Crucible project key) — machine-local, never committed.
.env

# Build and dependency output.
node_modules/
.venv/
*.egg-info/
coverage/
dist/
*.tgz
*.tsbuildinfo
*.log

# Editor / OS / other-harness debris.
.DS_Store
.vscode/
.idea/
.zed/
.claude/
docs/superpowers/plans/

# Generated by modelb-axi (Model B scaffold and `modelb-axi agents`) or machine-local Pi
# session settings — repo-local, never committed.
.pi/agents/
.pi/extensions/
.pi/settings.json
.pi/sol-pi.json
.lean-ctx.toml
