{
  "name": "@anthill-tec/sol-pi",
  "version": "0.1.0",
  "description": "Standalone context and tool-efficiency extensions for Pi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anthill-tec/SoL-Pi.git"
  },
  "type": "module",
  "files": [
    "src/sol-pi",
    "assets",
    "docs/compatibility.md",
    "docs/configuration.md",
    "scripts/check-sol-pi-config.mjs",
    "agents-install.md",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "sol-pi.example.json"
  ],
  "scripts": {
    "test": "bun test --timeout 30000",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test && bun pm pack --dry-run",
    "check:pi": "bun scripts/check-pi-compat.mjs"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "context-management"
  ],
  "pi": {
    "extensions": [
      "./src/sol-pi/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.84.2",
    "@earendil-works/pi-ai": ">=0.84.2",
    "@earendil-works/pi-coding-agent": ">=0.84.2",
    "@earendil-works/pi-tui": ">=0.84.2",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/bun": "1.4.4",
    "@types/node": "24.12.4",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "protobufjs": "7.6.5",
    "source-map-js": "1.2.2"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.4.4"
}
